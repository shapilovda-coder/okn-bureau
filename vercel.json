    },
    {
      "source": "/blog/arendator-obekta-kulturnogo-naslediya",
      "destination": "/blog-arendator-okn.html"
    },
    {
      "source": "/blog/sobstvennik-obekta-kulturnogo-naslediya-chto-delat",
